# Paper Review Iterative System — Configuration
# Copy this to config.yaml and fill in your settings

# === LLM Provider ===
# Options: "anthropic", "deepseek"
provider: "anthropic"

# API Key (or set environment variable: ANTHROPIC_API_KEY / DEEPSEEK_API_KEY)
api_key: ""

# Default model
# Anthropic: claude-sonnet-4-6, claude-opus-4-8, claude-haiku-4-5
# DeepSeek: deepseek-v4-pro, deepseek-v4-flash
model: "claude-sonnet-4-6"

# Review dimensions to enable by default
dimensions:
  - format        # 格式
  - language      # 用语规范
  - ai_free       # 无AI特点
  - math          # 数学推导
  - logic         # 行文逻辑
  - significance  # 研究意义

# Maximum review-revise rounds
max_rounds: 5

# Convergence threshold: stop when average review score < this value
convergence_threshold: 0.3

# Run review dimensions in parallel
parallel_reviews: true

# Output directory for iteration artifacts
output_dir: "output"

# LaTeX settings
latex:
  compiler: "pdflatex"
  auto_compile: false          # disabled by default (needs texlive)
  serve_preview: false
  preview_port: 8765
